# =============================================
# Synapse Backend — Dockerfile
# =============================================
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for caching
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .

# Copy data directory
COPY data/ /app/data/

# Environment
ENV DATA_RAW_DIR=/app/data/raw
ENV DATA_PROCESSED_DIR=/app/data/processed
ENV MODELS_DIR=/app/data/models
ENV HOST=0.0.0.0
ENV PORT=8000

EXPOSE 8000

# Hosting platforms provide PORT at runtime; Docker Compose retains PORT=8000.
CMD ["sh", "-c", "python -m uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
